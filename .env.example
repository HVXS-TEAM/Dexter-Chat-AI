# Dexter — environment variables
# Copy this file to .env and fill in real values.
# Never commit the .env file (see .gitignore).

DB_USER=change_me
DB_PASSWORD=change_me
DB_NAME=change_me
# Mode natif : @localhost:5432 — Mode Docker : @postgres:5432
DB_URL=postgresql+psycopg2://change_me:change_me@localhost:5432/change_me
JWT_SECRET=change_me

# --- LLM Providers (multi-modèles, PRD §7.2) ---
# Secrets backend uniquement : ne jamais les définir dans frontend/.env ni les préfixer par VITE_.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_MODEL_GENERATION=openai/gpt-oss-120b
LLM_API_KEY_CEREBRAS=
LLM_API_KEY_SAMBANOVA=

EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_MIN_SCORE=0.5
RAG_MAX_CHUNKS=5
UPLOAD_DIR=uploads

# --- OCR des documents images (png/jpg/jpeg) ---
# Chemin vers le binaire Tesseract. Sous Windows, l'installeur UB Mannheim
# l'installe ici (il n'est pas ajoute au PATH) :
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Dossier contenant les *.traineddata. Laisser vide pour utiliser celui du binaire.
# Utile quand le dossier d'installation n'est pas accessible en ecriture (sans
# droits administrateur) : on pointe alors vers un dossier utilisateur.
TESSDATA_DIR=
# Langue d'OCR, en code ISO 639-2 (fra = francais, eng = anglais).
OCR_LANG=fra
